### Variables
@baseUrl = http://localhost:3000
@token = YOUR_TOKEN_HERE
@adminToken = ADMIN_TOKEN_HERE
@tripId = TRIP_UUID_HERE
@userId = USER_ID_HERE

### Health Check
GET {{baseUrl}}/api/health

### ============================================
### AUTH ENDPOINTS
### ============================================

### Register new user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "test@test.com",
  "name": "Test",
  "surname": "User",
  "password": "password123"
}

### Login (admin)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@admin.com",
  "password": "admin"
}

### Login (test user)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "password123"
}

### Logout
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{token}}

### ============================================
### TRIPS ENDPOINTS (require authentication)
### ============================================

### Get all trips
GET {{baseUrl}}/api/trips
Authorization: Bearer {{token}}

### Get trip by ID
GET {{baseUrl}}/api/trips/{{tripId}}
Authorization: Bearer {{token}}

### Get trip by invalid UUID (should return 400)
GET {{baseUrl}}/api/trips/invalid-uuid
Authorization: Bearer {{token}}

### Get non-existent trip (should return 404)
GET {{baseUrl}}/api/trips/123e4567-e89b-12d3-a456-426614174000
Authorization: Bearer {{token}}

### Create new trip
POST {{baseUrl}}/api/trips
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Trip to Paris",
  "country": "France",
  "dateFrom": "2025-06-01",
  "dateTo": "2025-06-10",
  "tripType": ["city-break", "cultural"],
  "tags": ["Summer", "Europe"],
  "budget": "$2000",
  "description": "Amazing trip to Paris with Eiffel Tower visit!",
  "image": "/public/assets/eiffel-tower.jpg"
}

### Update trip
PUT {{baseUrl}}/api/trips/{{tripId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Trip to Paris",
  "country": "France",
  "dateFrom": "2025-07-01",
  "dateTo": "2025-07-15",
  "tripType": ["city-break"],
  "tags": ["Summer", "Vacation"],
  "budget": "$2500",
  "description": "Extended trip to Paris!",
  "image": "/public/assets/eiffel-tower.jpg"
}

### Delete trip
DELETE {{baseUrl}}/api/trips/{{tripId}}
Authorization: Bearer {{token}}

### ============================================
### ADMIN ENDPOINTS (require admin role)
### ============================================

### Get all users
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Update user role to ADMIN
PUT {{baseUrl}}/api/admin/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### Update user role to USER
PUT {{baseUrl}}/api/admin/users/{{userId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "role": "USER"
}

### Update user password
PUT {{baseUrl}}/api/admin/users/{{userId}}/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "password": "newpassword123"
}

### Delete user
DELETE {{baseUrl}}/api/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}

### ============================================
### EXPENSES ENDPOINTS (require authentication)
### ============================================

### Get all expense categories
GET {{baseUrl}}/api/expense-categories
Authorization: Bearer {{token}}

### Get all expenses for a trip
GET {{baseUrl}}/api/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}

### Get single expense
GET {{baseUrl}}/api/trips/{{tripId}}/expenses/EXPENSE_ID_HERE
Authorization: Bearer {{token}}

### Create new expense
POST {{baseUrl}}/api/trips/{{tripId}}/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 1,
  "amount": 150.50,
  "currency": "USD",
  "description": "Hotel booking",
  "expenseDate": "2026-02-10"
}

### Update expense
PUT {{baseUrl}}/api/trips/{{tripId}}/expenses/EXPENSE_ID_HERE
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 175.00,
  "description": "Updated hotel booking"
}

### Delete expense
DELETE {{baseUrl}}/api/trips/{{tripId}}/expenses/EXPENSE_ID_HERE
Authorization: Bearer {{token}}

### ============================================
### PACKING ITEMS ENDPOINTS (require authentication)
### ============================================

### Get all packing categories
GET {{baseUrl}}/api/packing-categories
Authorization: Bearer {{token}}

### Get all packing items for a trip
GET {{baseUrl}}/api/trips/{{tripId}}/packing
Authorization: Bearer {{token}}

### Create new packing item
POST {{baseUrl}}/api/trips/{{tripId}}/packing
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": 1,
  "name": "Passport",
  "quantity": 1,
  "isPacked": false,
  "priority": "high"
}

### Update packing item
PUT {{baseUrl}}/api/trips/{{tripId}}/packing/PACKING_ITEM_ID_HERE
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isPacked": true
}

### Delete packing item
DELETE {{baseUrl}}/api/trips/{{tripId}}/packing/PACKING_ITEM_ID_HERE
Authorization: Bearer {{token}}

### ============================================
### TODO ITEMS ENDPOINTS (require authentication)
### ============================================

### Get all todo items for a trip
GET {{baseUrl}}/api/trips/{{tripId}}/todos
Authorization: Bearer {{token}}

### Create new todo item
POST {{baseUrl}}/api/trips/{{tripId}}/todos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Book hotel",
  "description": "Reserve accommodation in city center",
  "dueDate": "2026-03-15",
  "priority": "high",
  "isCompleted": false
}

### Update todo item
PUT {{baseUrl}}/api/trips/{{tripId}}/todos/TODO_ITEM_ID_HERE
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isCompleted": true
}

### Delete todo item
DELETE {{baseUrl}}/api/trips/{{tripId}}/todos/TODO_ITEM_ID_HERE
Authorization: Bearer {{token}}

### ============================================
### ERROR TESTING
### ============================================

### 401 - No token
GET {{baseUrl}}/api/trips

### 401 - Invalid token
GET {{baseUrl}}/api/trips
Authorization: Bearer invalid.token.here

### 403 - Access denied (non-admin trying to access admin endpoint)
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{token}}

### 400 - Missing required fields
POST {{baseUrl}}/api/trips
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Incomplete Trip"
}

### 404 - Route not found
GET {{baseUrl}}/api/nonexistent
